# ─────────────────────────────────────────────────────────────
# Gauge — environment variables
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# --- Backend (/api) ---

# Postgres connection string.
# Local dev (docker-compose) default:
DATABASE_URL=postgresql+psycopg://gauge:gauge@localhost:5432/gauge

# Anthropic API key. Read from the environment; never hardcoded.
# If UNSET, Gauge runs in mock mode: triggered runs use a deterministic
# stub executor so the demo is fully clickable with zero setup.
# If SET, triggered runs call the real Anthropic API.
ANTHROPIC_API_KEY=

# Default model used when a run does not specify one.
GAUGE_DEFAULT_MODEL=claude-haiku-4-5-20251001

# CORS: comma-separated list of allowed web origins.
GAUGE_CORS_ORIGINS=http://localhost:3000

# --- Frontend (/web) ---

# Base URL of the FastAPI backend the web app talks to.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
