# --- Database ---
# SQLite by default (zero external services). To use Postgres, change the
# datasource provider in prisma/schema.prisma to "postgresql" and point this
# at your connection string.
DATABASE_URL="file:./dev.db"

# --- Session ---
# Any long random string. Used to sign session JWTs.
AUTH_SECRET="change-me-to-a-long-random-string"

# --- App ---
# Public base URL, used for OAuth redirect callbacks.
APP_URL="http://localhost:3000"

# --- GitHub OAuth ---
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: ${APP_URL}/api/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Anthropic ---
# Used by the BRD agent to write acceptance criteria (Given/When/Then).
ANTHROPIC_API_KEY=""
# Model id is configurable; defaults to a Sonnet model.
ANTHROPIC_MODEL="claude-sonnet-4-5"
