# ─────────────────────────────────────────────────────────────
# Gauge — environment variables
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# --- Backend (/api) ---

# Postgres connection string.
# Local dev (docker-compose) default:
DATABASE_URL=postgresql+psycopg://gauge:gauge@localhost:5432/gauge

# Kimi (Moonshot AI) API key. Read from the environment; never hardcoded.
# If UNSET, Gauge runs in mock mode: triggered runs use a deterministic
# stub executor so the demo is fully clickable with zero setup.
# If SET, triggered runs call the real Kimi API (OpenAI-compatible).
MOONSHOT_API_KEY=

# Kimi (Moonshot) API base URL (OpenAI-compatible). The .cn endpoint is also
# available: https://api.moonshot.cn/v1
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Default model used when a run does not specify one.
GAUGE_DEFAULT_MODEL=kimi-k2.6

# CORS: comma-separated list of allowed web origins.
GAUGE_CORS_ORIGINS=http://localhost:3000

# Per-case pacing (ms) for the mock executor, so live run progress is
# observable in the UI during a demo run. Set to 0 to disable.
GAUGE_MOCK_DELAY_MS=140

# --- Frontend (/web) ---

# Base URL of the FastAPI backend the web app talks to.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
