// Baton — data model (BA-to-QA pipeline)
//
// A Company registers with an owner. Owners/admins invite collaborators and
// assign roles. Stakeholders file Requests. Each Request runs through a
// pipeline of agent stages, produces artifacts (UX check, BRD, plan, build,
// test, PR), and pauses for human approval after the BRD is drafted.
//
// SQLite by default for zero-setup local dev. To move to Postgres, change
// `provider` to "postgresql" and update DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // GitHub connection (per-company repo the pipeline targets)
  githubConnected    Boolean @default(false)
  githubLogin        String?
  githubAccessToken  String? // encrypted-at-rest in production; stored plainly in dev
  githubDefaultRepo  String? // e.g. "acme/webapp"
  appBaseUrl         String? // where the company's app runs; UX-check drives it
  previewUrlTemplate String? // per-branch preview URL, e.g. "https://app-{branch}.up.railway.app"

  members      Membership[]
  requests     Request[]
  requirements RequirementDoc[]
  repos        Repo[]
}

// A GitHub repository connected to a company. A company connects GitHub once
// (OAuth) and can attach several repos; one is the default the pipeline targets
// when a request doesn't pick a specific one. `githubDefaultRepo` on Company
// mirrors the default repo's fullName for backward-compatible reads.
model Repo {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName  String // "owner/name"
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([companyId, fullName])
  @@index([companyId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  createdRequests Request[] @relation("RequestCreatedBy")
  decisions   Approval[]
}

// NOTE: SQLite doesn't support native enums, so role/type/status/decision are
// stored as strings. The allowed values live in `src/lib/domain.ts` as
// string-literal union types (Role, RequestType, RequestStatus,
// ApprovalDecision). Switch the datasource to Postgres to use real enums.

model Membership {
  id        String   @id @default(cuid())
  role      String   @default("COLLABORATOR") // Role
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Requests & pipeline
// ---------------------------------------------------------------------------

model Request {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String   @default("UNKNOWN") // RequestType
  status      String   @default("INTAKE") // RequestStatus
  priority    String   @default("normal") // low | normal | high
  repoFullName String? // which connected repo this request targets (null → company default)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("RequestCreatedBy", fields: [createdById], references: [id])

  uxCheck   UxCheck?
  brd       Brd?
  plan      Plan?
  build     Build?
  impact    RequirementImpact?
  checks    VerificationCheck[]
  pullReq   PullRequestRef?
  approvals Approval[]
  events    PipelineEvent[]

  @@index([companyId])
  @@index([status])
}

// Per-request impact analysis against the living requirements corpus: which
// existing requirements this request AFFECTS, and the drafted new/updated
// Gherkin the pipeline will commit alongside the code (Phase 3).
model RequirementImpact {
  id        String   @id @default(cuid())
  requestId String   @unique
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  summary   String   @default("")
  related   String   @default("[]") // JSON: [{ reqId, title, category, filePath, affected, reason }]
  drafts    String   @default("[]") // JSON: [{ op, reqId?, category, title, filePath, body, codeAreas }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// UX-check agent output: classifies bug vs feature and either reproduces the
// bug (Playwright/MCP) or analyzes the feature against the code.
model UxCheck {
  id             String   @id @default(cuid())
  requestId      String   @unique
  request        Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  classifiedType String // RequestType (BUG | FEATURE)
  reproduced     Boolean  @default(false) // for bugs: was it reproduced?
  summary        String   // human-readable finding
  steps          String   // JSON array of reproduction / investigation steps
  screenshots    String   // JSON array of artifact paths (stubbed for now)
  createdAt      DateTime @default(now())
}

// BRD agent output: business/UX-facing requirements in Gherkin
// (Given / When / Then) plus a plain-language narrative.
model Brd {
  id                 String   @id @default(cuid())
  requestId          String   @unique
  request            Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  narrative          String   // plain-language BRD, BA/UX voice (no dev jargon)
  gherkin            String   // Feature: ... Scenario ... Given/When/Then
  acceptanceCriteria String   // JSON array of acceptance-criteria bullet strings
  model              String   // which Anthropic model produced it
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Approval {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  decision  String // ApprovalDecision (ACCEPTED | REJECTED | ALTERED)
  note      String? // reason / change notes
  createdAt DateTime @default(now())

  @@index([requestId])
}

model Plan {
  id        String   @id @default(cuid())
  requestId String   @unique
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  summary   String
  steps     String   // JSON array of plan steps
  files     String   // JSON array of files the builder is expected to touch
  createdAt DateTime @default(now())
}

model Build {
  id         String   @id @default(cuid())
  requestId  String   @unique
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  branch     String
  summary    String
  diff       String   // unified diff (stubbed for now)
  createdAt  DateTime @default(now())
}

// One record per verification check (acceptance UX, bug-fix review,
// regression). Each is its own pipeline stage with its own card + screenshots.
model VerificationCheck {
  id          String   @id @default(cuid())
  requestId   String
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind        String // "acceptance" | "bugfix" | "regression"
  passed      Boolean  @default(false)
  summary     String
  output      String // JSON array of result lines
  screenshots String   @default("[]") // JSON array of artifact paths
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requestId, kind])
  @@index([requestId])
}

model PullRequestRef {
  id        String   @id @default(cuid())
  requestId String   @unique
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  number    Int?
  url       String
  title     String
  createdAt DateTime @default(now())
}

// Searchable index of the living requirements corpus. The source of truth is
// version-controlled files in the target repo (requirements/<category>/REQ-*.md);
// Baton mirrors them here so it can search and run impact analysis quickly.
// Re-synced from the repo whenever a PR that touches requirements merges.
model RequirementDoc {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  repo            String // owner/name the requirement belongs to
  reqId           String // stable id in the file, e.g. REQ-ab12cd34
  category        String // ux | design | backend | data | api
  title           String
  status          String   @default("accepted") // draft | accepted | superseded
  version         Int      @default(1)
  related         String   @default("[]") // JSON array of related reqIds
  codeAreas       String   @default("[]") // JSON array of file paths/globs it governs
  body            String // the behavior spec (markdown)
  filePath        String // requirements/<category>/REQ-*.md
  updatedBySource String? // requestId that last changed it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, reqId])
  @@index([companyId])
  @@index([companyId, category])
}

// Background work queue. Filing a request (or approving a BRD) enqueues a Job;
// an in-process worker runs the pipeline off the request path. Durable, so
// queued work survives a restart.
model Job {
  id        String   @id @default(cuid())
  requestId String   @default("") // the request this job runs for ("" for company-scoped jobs)
  companyId String? // set for company-scoped jobs (e.g. seed_requirements)
  kind      String // "to_approval" | "after_approval" | "seed_requirements"
  status    String   @default("queued") // queued | running | done | error
  attempts  Int      @default(0)
  error     String?
  result    String? // optional JSON summary of the outcome (e.g. seeded PR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([companyId, kind])
}

// Append-only audit trail of everything the pipeline does.
model PipelineEvent {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stage     String   // e.g. "ux_check", "brd", "approval", "planner"
  level     String   @default("info") // info | warn | error
  message   String
  data      String? // JSON blob of stage detail
  createdAt DateTime @default(now())

  @@index([requestId])
}
